            <p class="text-[10px] tracking-[0.25em] uppercase mb-5" style="color:rgba(255,255,255,0.2);">Связаться</p>
            <a href="tel:+79615192400"
               class="block font-display text-xl tracking-widest no-underline mb-2 transition-colors duration-300 footer-phone"
               style="color:#fff;">+7 (961) 519-24-00</a>
            <p class="text-xs tracking-wider mb-6" style="color:rgba(255,255,255,0.22);">Новороссийск</p>
            <a href="/zero-day"
               class="inline-flex items-center gap-2 text-xs tracking-widest uppercase no-underline hover:opacity-60 transition-opacity duration-300"
               style="color:#C8A882;">
              Записаться на встречу
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>
        </div>
        <div class="border-t pt-8 flex flex-col sm:flex-row justify-between items-center gap-4"
             style="border-color:rgba(255,255,255,0.07);">
          <p class="text-[10px] tracking-widest uppercase" style="color:rgba(255,255,255,0.18);">
            © 2025 ЦЕЛОЕ. Все права защищены.
          </p>
