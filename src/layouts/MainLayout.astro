    <!-- КНОПКА ЗВОНКА -->
    <a href="tel:+79615192400" id="fixed-call"
       class="fixed bottom-6 right-6 z-50 flex items-center gap-3 no-underline border transition-all duration-500"
       style="padding:12px 18px;border-color:#DDD8D0;background:rgba(245,240,232,0.95);
              backdrop-filter:blur(8px);color:#6B6560;font-size:11px;
              letter-spacing:0.12em;text-transform:uppercase;opacity:0;pointer-events:none;"
       aria-label="Позвонить нам">
      <svg class="w-4 h-4 shrink-0" style="color:#C8A882;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      <span id="call-label" style="max-width:0;overflow:hidden;white-space:nowrap;
                                    transition:max-width 0.4s cubic-bezier(0.22,1,0.36,1);">
        Позвонить
      </span>
    </a>

    <script>
      const header   = document.getElementById('site-header');
      const logo     = document.getElementById('logo');
      const navItems = document.querySelectorAll('.nav-item');
      const navSubs  = document.querySelectorAll('.nav-sub');
      const bTop = document.getElementById('b-top');
      const bMid = document.getElementById('b-mid');
      const bBot = document.getElementById('b-bot');

      function updateHeader() {
        const scrolled = window.scrollY > 60;
        if (scrolled) {
          header.style.background     = 'rgba(245,240,232,0.96)';
          header.style.backdropFilter = 'blur(12px)';
          header.style.boxShadow      = '0 1px 0 rgba(26,23,20,0.07)';
          header.style.padding        = '0.875rem 1.5rem';
          logo.style.color            = '#1A1714';
          navItems.forEach(el => { el.style.color = 'rgba(26,23,20,0.5)'; });
          navSubs.forEach(el  => { el.style.color = 'rgba(26,23,20,0.28)'; });
          bTop.style.background = bMid.style.background = bBot.style.background = '#1A1714';
        } else {
          header.style.background     = 'transparent';
          header.style.backdropFilter = 'none';
          header.style.boxShadow      = 'none';
          header.style.padding        = '1.25rem 1.5rem';
          logo.style.color            = '#fff';
          navItems.forEach(el => { el.style.color = 'rgba(255,255,255,0.7)'; });
          navSubs.forEach(el  => { el.style.color = 'rgba(255,255,255,0.25)'; });
          bTop.style.background = bMid.style.background = bBot.style.background = '#fff';
        }
      }
      updateHeader();
      window.addEventListener('scroll', updateHeader, { passive: true });

      const burger     = document.getElementById('burger');
      const mobileMenu = document.getElementById('mobile-menu');
      let menuOpen = false;

      function showDesktop() {
        document.getElementById('desktop-nav').style.display = 'flex';
        burger.style.display = 'none';
      }
      function showMobile() {
        document.getElementById('desktop-nav').style.display = 'none';
        burger.style.display = 'flex';
      }
      if (window.innerWidth >= 768) showDesktop(); else showMobile();
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) showDesktop(); else showMobile();
      });

      function closeMenu() {
        menuOpen = false;
        mobileMenu.style.opacity = '0';
        mobileMenu.style.pointerEvents = 'none';
        bTop.style.transform = bBot.style.transform = '';
        bMid.style.opacity = '';
      }
      burger.addEventListener('click', () => {
        menuOpen = !menuOpen;
        if (menuOpen) {
          mobileMenu.style.opacity = '1';
          mobileMenu.style.pointerEvents = 'auto';
          bTop.style.transform = 'rotate(45deg) translateY(7px)';
          bMid.style.opacity   = '0';
          bBot.style.transform = 'rotate(-45deg) translateY(-7px)';
        } else {
          closeMenu();
        }
      });
      document.querySelectorAll('.mob-link').forEach(l => l.addEventListener('click', closeMenu));

      const fixedCall = document.getElementById('fixed-call');
      const callLabel = document.getElementById('call-label');
      window.addEventListener('scroll', () => {
        const show = window.scrollY > 300;
        fixedCall.style.opacity       = show ? '1' : '0';
        fixedCall.style.pointerEvents = show ? 'auto' : 'none';
      }, { passive: true });
      fixedCall.addEventListener('mouseenter', () => {
        fixedCall.style.borderColor = '#C8A882';
        fixedCall.style.color = '#C8A882';
        callLabel.style.maxWidth = '100px';
      });
      fixedCall.addEventListener('mouseleave', () => {
        fixedCall.style.borderColor = '#DDD8D0';
        fixedCall.style.color = '#6B6560';
        callLabel.style.maxWidth = '0';
      });

      const revealObs = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -32px 0px' });
      document.querySelectorAll('.reveal, .reveal-fade, .reveal-line')
        .forEach(el => revealObs.observe(el));
    </script>
    <CookieBanner />
