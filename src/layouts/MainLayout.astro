---
import '../styles/global.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Целое — Цельный ремонт</title>
    <!-- SEO -->
    <meta name="description" content="ЦЕЛОЕ — ремонт квартир под ключ в Москве. Фиксированная цена, сдача в срок, команда без субподрядчиков." />
    <meta name="keywords" content="ремонт квартир Москва, ремонт под ключ, дизайн интерьера" />
    <meta property="og:title" content="Целое — Цельный ремонт" />
    <meta property="og:description" content="Ремонт квартир под ключ. Фиксированная цена. Сдача день в день." />
    <meta property="og:type" content="website" />
  </head>
  <body>

    <!-- ─── ШАПКА ────────────────────────────────────────────── -->
    <header class="fixed top-0 left-0 right-0 z-20 px-6 py-4 flex justify-between items-center">

      <!-- Логотип -->
      <a href="/"
         class="font-display text-2xl tracking-widest text-white no-underline z-30"
         style="font-family:'Playfair Display',serif;">
        ЦЕЛОЕ
      </a>

      <!-- Бургер (мобильный) -->
      <button id="burger"
              class="z-50 flex-col gap-1 bg-transparent border-0 cursor-pointer p-1"
              aria-label="Открыть меню">
        <span id="burger-top" class="block w-6 h-px bg-white transition-transform duration-300"></span>
        <span id="burger-mid" class="block w-6 h-px bg-white transition-opacity duration-300 mt-1"></span>
        <span id="burger-bot" class="block w-6 h-px bg-white transition-transform duration-300 mt-1"></span>
      </button>

      <!-- Навигация (десктоп) — с расшифровками -->
      <nav id="desktop-nav" class="hidden gap-8 items-start">
        <a href="/" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Главная</span>
        </a>
        <a href="/zero-day" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Нулевой День</span>
          <span class="text-white/30 text-[9px] tracking-wider normal-case group-hover:text-white/50 transition-colors duration-300">Первая встреча</span>
        </a>
        <a href="/digital-rehearsal" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Репетиция</span>
          <span class="text-white/30 text-[9px] tracking-wider normal-case group-hover:text-white/50 transition-colors duration-300">3D-визуализация</span>
        </a>
        <a href="/transparent-perimeter" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Периметр</span>
          <span class="text-white/30 text-[9px] tracking-wider normal-case group-hover:text-white/50 transition-colors duration-300">Договор и гарантии</span>
        </a>
        <a href="/ready-modules" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Модули</span>
          <span class="text-white/30 text-[9px] tracking-wider normal-case group-hover:text-white/50 transition-colors duration-300">Готовые пакеты</span>
        </a>
        <a href="/portfolio" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Проекты</span>
          <span class="text-white/30 text-[9px] tracking-wider normal-case group-hover:text-white/50 transition-colors duration-300">Наши работы</span>
        </a>
        <a href="/contacts" class="nav-link group flex flex-col items-start gap-0.5 no-underline">
          <span class="text-white/70 text-xs tracking-widest uppercase group-hover:text-white transition-colors duration-300">Контакты</span>
        </a>
      </nav>
    </header>

    <!-- Мобильное меню (fullscreen) -->
    <div id="mobile-menu"
         class="fixed inset-0 z-40 flex flex-col items-center justify-center gap-8 bg-monolith-bg"
         style="opacity:0;pointer-events:none;transition:opacity 0.5s;">
      <a href="/"          class="mobile-link text-white text-lg tracking-widest uppercase no-underline opacity-70 hover:opacity-100 transition-opacity">Главная</a>
      <a href="/zero-day"  class="mobile-link flex flex-col items-center gap-1 no-underline">
        <span class="text-white text-lg tracking-widest uppercase opacity-70 hover:opacity-100 transition-opacity">Нулевой День</span>
        <span class="text-white/30 text-xs tracking-wider">Первая встреча</span>
      </a>
      <a href="/digital-rehearsal" class="mobile-link flex flex-col items-center gap-1 no-underline">
        <span class="text-white text-lg tracking-widest uppercase opacity-70 hover:opacity-100 transition-opacity">Репетиция</span>
        <span class="text-white/30 text-xs tracking-wider">3D-визуализация</span>
      </a>
      <a href="/transparent-perimeter" class="mobile-link flex flex-col items-center gap-1 no-underline">
        <span class="text-white text-lg tracking-widest uppercase opacity-70 hover:opacity-100 transition-opacity">Периметр</span>
        <span class="text-white/30 text-xs tracking-wider">Договор и гарантии</span>
      </a>
      <a href="/ready-modules" class="mobile-link flex flex-col items-center gap-1 no-underline">
        <span class="text-white text-lg tracking-widest uppercase opacity-70 hover:opacity-100 transition-opacity">Модули</span>
        <span class="text-white/30 text-xs tracking-wider">Готовые пакеты</span>
      </a>
      <a href="/portfolio"  class="mobile-link flex flex-col items-center gap-1 no-underline">
        <span class="text-white text-lg tracking-widest uppercase opacity-70 hover:opacity-100 transition-opacity">Проекты</span>
        <span class="text-white/30 text-xs tracking-wider">Наши работы</span>
      </a>
      <a href="/contacts"  class="mobile-link text-white text-lg tracking-widest uppercase no-underline opacity-70 hover:opacity-100 transition-opacity">Контакты</a>
      <!-- Телефон в мобильном меню -->
      <a href="tel:+79615192400" class="mt-4 text-monolith-accent-warm text-sm tracking-widest no-underline">
        +7 (961) 519-24-00
      </a>
    </div>

    <!-- ─── ОСНОВНОЙ КОНТЕНТ ──────────────────────────────────── -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- ─── ФИКСИРОВАННАЯ КНОПКА ЗВОНКА ─────────────────────── -->
    <a href="tel:+79615192400"
       id="fixed-call"
       class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-4 py-3 border border-monolith-border bg-monolith-bg/90 backdrop-blur-sm text-monolith-text-secondary text-xs tracking-widest uppercase no-underline transition-all duration-500 hover:border-monolith-accent-warm hover:text-monolith-accent-warm"
       aria-label="Позвонить нам">
      <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
      </svg>
      <span id="call-label" class="overflow-hidden max-w-0 transition-all duration-500 whitespace-nowrap">
        Позвонить
      </span>
    </a>

    <!-- ─── СКРИПТЫ ───────────────────────────────────────────── -->
    <script>
      // Навигация: десктоп / мобильный
      const burger     = document.getElementById('burger');
      const menu       = document.getElementById('mobile-menu');
      const desktopNav = document.getElementById('desktop-nav');
      const topEl      = document.getElementById('burger-top');
      const mid        = document.getElementById('burger-mid');
      const bot        = document.getElementById('burger-bot');
      const mobileLinks = menu.querySelectorAll('a');
      let open = false;

      function showDesktop() {
        desktopNav.style.display = 'flex';
        burger.style.display = 'none';
      }
      function showMobile() {
        desktopNav.style.display = 'none';
        burger.style.display = 'flex';
      }

      if (window.innerWidth >= 768) showDesktop(); else showMobile();
      window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) showDesktop(); else showMobile();
      });

      burger.addEventListener('click', () => {
        open = !open;
        menu.style.opacity        = open ? '1' : '0';
        menu.style.pointerEvents  = open ? 'auto' : 'none';
        topEl.style.transform     = open ? 'rotate(45deg) translateY(6px)' : '';
        mid.style.opacity         = open ? '0' : '';
        bot.style.transform       = open ? 'rotate(-45deg) translateY(-6px)' : '';
      });

      mobileLinks.forEach(link => link.addEventListener('click', () => {
        menu.style.opacity = '0';
        menu.style.pointerEvents = 'none';
        topEl.style.transform = mid.style.opacity = bot.style.transform = '';
        open = false;
      }));

      // Фиксированная кнопка: показать номер при наведении
      const fixedCall = document.getElementById('fixed-call');
      const callLabel = document.getElementById('call-label');
      fixedCall.addEventListener('mouseenter', () => {
        callLabel.style.maxWidth = '100px';
      });
      fixedCall.addEventListener('mouseleave', () => {
        callLabel.style.maxWidth = '0';
      });

      // Скрываем кнопку звонка в самом верху (телефон уже виден в hero)
      window.addEventListener('scroll', () => {
        fixedCall.style.opacity = window.scrollY < 300 ? '0' : '1';
        fixedCall.style.pointerEvents = window.scrollY < 300 ? 'none' : 'auto';
      }, { passive: true });
    </script>
  </body>
</html>