---
import '../styles/global.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>Монолит — Цельный ремонт</title>
  </head>
  <body class="bg-monolith-bg text-monolith-text-primary font-body">
    <header class="fixed top-0 left-0 right-0 z-30 px-6 py-4 md:px-8 md:py-6 flex justify-between items-center pointer-events-none">
      <a href="/" class="font-display text-xl md:text-2xl tracking-widest text-white no-underline z-30 pointer-events-auto">МОНОЛИТ</a>
      <button id="burger" style="display:none;z-index:50;flex-direction:column;gap:4px;background:none;border:none;cursor:pointer;pointer-events:auto;">
        <span id="burger-top" style="display:block;width:24px;height:1px;background:#fff;"></span>
        <span id="burger-mid" style="display:block;width:24px;height:1px;background:#fff;"></span>
        <span id="burger-bot" style="display:block;width:24px;height:1px;background:#fff;"></span>
      </button>
      <div id="mobile-menu" style="position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rem;opacity:0;pointer-events:none;transition:opacity 0.3s;background:#0A0A0F;height:100dvh;">
        <a href="/" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Главная</a>
        <a href="/zero-day" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Нулевой День</a>
        <a href="/digital-rehearsal" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Репетиция</a>
        <a href="/transparent-perimeter" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Периметр</a>
        <a href="/ready-modules" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Модули</a>
        <a href="/portfolio" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Проекты</a>
        <a href="/contacts" style="color:#fff;font-size:1.1rem;letter-spacing:0.1em;text-transform:uppercase;text-decoration:none;">Контакты</a>
      </div>
      <nav class="hidden md:flex gap-8 text-xs tracking-widest uppercase text-white/70 pointer-events-auto">
        <a href="/" class="hover:text-white transition-colors duration-300">Главная</a>
        <a href="/zero-day" class="hover:text-white transition-colors duration-300">Нулевой День</a>
        <a href="/digital-rehearsal" class="hover:text-white transition-colors duration-300">Репетиция</a>
        <a href="/transparent-perimeter" class="hover:text-white transition-colors duration-300">Периметр</a>
        <a href="/ready-modules" class="hover:text-white transition-colors duration-300">Модули</a>
        <a href="/portfolio" class="hover:text-white transition-colors duration-300">Проекты</a>
        <a href="/contacts" class="hover:text-white transition-colors duration-300">Контакты</a>
      </nav>
    </header>
    <main class="relative z-10">
      <slot />
    </main>
    <script>
      const burger = document.getElementById('burger');
      const menu = document.getElementById('mobile-menu');
      const topEl = document.getElementById('burger-top');
      const mid = document.getElementById('burger-mid');
      const bot = document.getElementById('burger-bot');
      const links = menu.querySelectorAll('a');
      let open = false;
      let touchStartY = 0;

      document.addEventListener('touchstart', (e) => {
        touchStartY = e.touches[0].clientY;
      }, { passive: true });

      function updateBurger() {
        if (window.innerWidth < 768) {
          burger.style.display = 'flex';
        } else {
          burger.style.display = 'none';
          menu.style.opacity = '0';
          menu.style.pointerEvents = 'none';
          open = false;
        }
      }
      updateBurger();
      window.addEventListener('resize', updateBurger);

      burger.addEventListener('click', (e) => {
        const touchEndY = e.changedTouches ? e.changedTouches[0].clientY : touchStartY;
        if (Math.abs(touchEndY - touchStartY) > 10) return;
        open = !open;
        menu.style.opacity = open ? '1' : '0';
        menu.style.pointerEvents = open ? 'auto' : 'none';
        if (open) {
          topEl.style.transform = 'rotate(45deg) translateY(6px)';
          mid.style.opacity = '0';
          bot.style.transform = 'rotate(-45deg) translateY(-6px)';
        } else {
          topEl.style.transform = '';
          mid.style.opacity = '';
          bot.style.transform = '';
        }
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          open = false;
          menu.style.opacity = '0';
          menu.style.pointerEvents = 'none';
          topEl.style.transform = '';
          mid.style.opacity = '';
          bot.style.transform = '';
        });
      });
    </script>
  </body>
</html>