---
import '../styles/global.css';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Монолит — Цельный ремонт</title>
  </head>
  <body class="bg-monolith-bg text-monolith-text-primary font-body">
    <header class="fixed top-0 left-0 right-0 z-30 px-6 py-4 md:px-8 md:py-6 flex justify-between items-center">
      <a href="/" class="font-display text-xl md:text-2xl tracking-widest text-white no-underline z-30">МОНОЛИТ</a>
      <button id="burger" style="display:none;z-index:50;flex-direction:column;gap:4px;background:none;border:none;cursor:pointer;">
        <span id="burger-top" style="display:block;width:24px;height:1px;background:#fff;"></span>
        <span id="burger-mid" style="display:block;width:24px;height:1px;background:#fff;"></span>
        <span id="burger-bot" style="display:block;width:24px;height:1px;background:#fff;"></span>
      </button>
      <div id="mobile-menu" class="fixed inset-0 z-50 flex flex-col items-center justify-center gap-8 opacity-0 pointer-events-none transition-opacity duration-500" style="background-color: #0A0A0F;">
        <a href="/" class="text-white text-lg tracking-widest uppercase">Главная</a>
        <a href="/zero-day" class="text-white text-lg tracking-widest uppercase">Нулевой День</a>
        <a href="/digital-rehearsal" class="text-white text-lg tracking-widest uppercase">Репетиция</a>
        <a href="/transparent-perimeter" class="text-white text-lg tracking-widest uppercase">Периметр</a>
        <a href="/ready-modules" class="text-white text-lg tracking-widest uppercase">Модули</a>
        <a href="/portfolio" class="text-white text-lg tracking-widest uppercase">Проекты</a>
        <a href="/contacts" class="text-white text-lg tracking-widest uppercase">Контакты</a>
      </div>
      <nav class="hidden md:flex gap-8 text-xs tracking-widest uppercase text-white/70">
        <a href="/" class="hover:text-white transition-colors duration-300">Главная</a>
        <a href="/zero-day" class="hover:text-white transition-colors duration-300">Нулевой День</a>
        <a href="/digital-rehearsal" class="hover:text-white transition-colors duration-300">Репетиция</a>
        <a href="/transparent-perimeter" class="hover:text-white transition-colors duration-300">Периметр</a>
        <a href="/ready-modules" class="hover:text-white transition-colors duration-300">Модули</a>
        <a href="/portfolio" class="hover:text-white transition-colors duration-300">Проекты</a>
        <a href="/contacts" class="hover:text-white transition-colors duration-300">Контакты</a>
      </nav>
    </header>
    <main class="relative z-10">
      <slot />
    </main>
    <script>
      const burger = document.getElementById('burger');
      const menu = document.getElementById('mobile-menu');
      const topEl = document.getElementById('burger-top');
      const mid = document.getElementById('burger-mid');
      const bot = document.getElementById('burger-bot');
      const links = menu.querySelectorAll('a');
      let open = false;

      function updateBurger() {
        if (window.innerWidth < 768) {
          burger.style.display = 'flex';
        } else {
          burger.style.display = 'none';
          menu.style.opacity = '0';
          menu.style.pointerEvents = 'none';
          open = false;
        }
      }
      updateBurger();
      window.addEventListener('resize', updateBurger);

      burger.addEventListener('click', () => {
        open = !open;
        if (open) {
          menu.style.opacity = '1';
          menu.style.pointerEvents = 'auto';
          topEl.style.transform = 'rotate(45deg) translateY(6px)';
          mid.style.opacity = '0';
          bot.style.transform = 'rotate(-45deg) translateY(-6px)';
        } else {
          menu.style.opacity = '0';
          menu.style.pointerEvents = 'none';
          topEl.style.transform = '';
          mid.style.opacity = '';
          bot.style.transform = '';
        }
      });

      links.forEach(link => {
        link.addEventListener('click', () => {
          menu.style.opacity = '0';
          menu.style.pointerEvents = 'none';
          topEl.style.transform = '';
          mid.style.opacity = '';
          bot.style.transform = '';
          open = false;
        });
      });
    </script>
  </body>
</html>