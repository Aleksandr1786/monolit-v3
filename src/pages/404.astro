---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout>

  <section class="min-h-screen flex flex-col items-center justify-center text-center px-6"
           style="background:#F5F0E8;">

    <!-- Большая цифра -->
    <p class="font-display reveal"
       style="font-size:clamp(6rem,20vw,14rem);color:#EDE8DF;line-height:1;user-select:none;">
      404
    </p>

    <!-- Контент -->
    <div class="reveal delay-1 -mt-4">
      <h1 class="font-display text-2xl md:text-3xl mb-4" style="color:#1A1714;">
        Страница не найдена
      </h1>
      <div class="w-10 h-px mx-auto mb-6" style="background:#C8A882;"></div>
      <p class="text-base max-w-sm mx-auto mb-10" style="color:#6B6560;line-height:1.7;">
        Возможно, страница была удалена или вы перешли по неверной ссылке. Вернитесь на главную — там всё на месте.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/" class="btn-primary">На главную</a>
        <a href="/contacts" class="btn-secondary">Связаться с нами</a>
      </div>
    </div>

  </section>

</MainLayout>