---
import MainLayout from '../layouts/MainLayout.astro';
import HexBackground from '../components/HexBackground.astro';
import Manifesto from '../components/Manifesto.astro';
import Vectors from '../components/Vectors.astro';
import AiConsultant from '../components/AiConsultant.astro';
import Portfolio from '../components/Portfolio.astro';
import Calculator from '../components/Calculator.astro';
---

<MainLayout>
  <HexBackground />
  <section class="h-screen flex flex-col items-center justify-center text-center px-4 md:px-6 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-monolith-bg/80 via-monolith-bg/60 to-monolith-bg/90 pointer-events-none z-0"></div>
    <div class="relative z-10">
      <h1 class="heading-xl mb-6 text-3xl md:text-5xl lg:text-6xl">
        Пространство, с которого<br class="hidden md:block" /> начинается новая глава
      </h1>
      <div class="divider mx-auto"></div>
      <p class="text-monolith-text-secondary text-base md:text-lg max-w-xl mb-10 px-2">
        Монолит. Архитектура жизни. Цельный ремонт.
      </p>
      <a href="/zero-day" class="btn-monolith text-sm md:text-base no-underline">
        Начать погружение
      </a>
    </div>
  </section>
  <Manifesto />
  <Vectors />
  <AiConsultant />
  <Portfolio />
  <Calculator />
  <style>
  #burger { display: none !important; }
</style>
</MainLayout>