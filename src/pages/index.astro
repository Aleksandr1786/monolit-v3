---
import MainLayout from '../layouts/MainLayout.astro';
import Manifesto from '../components/Manifesto.astro';
import Vectors from '../components/Vectors.astro';
import AiConsultant from '../components/AiConsultant.astro';
import Portfolio from '../components/Portfolio.astro';
import Calculator from '../components/Calculator.astro';
---

<MainLayout>

  <!-- ═══════════════════════════════════════════════════════
       HERO — тёмный, с фоновым фото
  ═══════════════════════════════════════════════════════ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center text-center px-6 overflow-hidden"
           style="background:#0A0A0F;">

    <!-- Фоновое фото. Положи файл: public/images/hero.jpg
         Пока фото нет — виден градиент ниже, ничего не сломается -->
    <img
      src="/images/hero.jpg"
      alt="Интерьер ЦЕЛОЕ — ремонт квартир в Новороссийске"
      class="absolute inset-0 w-full h-full object-cover"
      style="opacity:0.55;"
      onerror="this.style.display='none'"
    />

    <!-- Градиент поверх фото -->
    <div class="absolute inset-0 pointer-events-none"
         style="background: linear-gradient(
           to bottom,
           rgba(10,10,15,0.72) 0%,
           rgba(10,10,15,0.45) 40%,
           rgba(10,10,15,0.78) 80%,
           #0A0A0F 100%
         );"></div>

    <!-- Контент hero -->
    <div class="relative z-10 max-w-3xl w-full">

      <!-- Метка города -->
      <p class="hero-line label-dark mb-10"
         style="opacity:0;animation:heroEnter 0.8s cubic-bezier(0.22,1,0.36,1) 0.1s forwards;">
        Ремонт квартир под ключ · Новороссийск
      </p>

      <!-- Главный заголовок -->
      <h1 class="font-display font-normal leading-tight mb-6"
          style="font-size:clamp(2rem,5vw,4rem);color:#E8E8F0;letter-spacing:-0.01em;
                 opacity:0;animation:heroEnter 0.9s cubic-bezier(0.22,1,0.36,1) 0.25s forwards;">
        Пространство, с которого<br />начинается новая глава
      </h1>

      <!-- Разделитель -->
      <div class="mx-auto my-6"
           style="width:40px;height:1px;background:#2E2A24;transform-origin:left;
                  opacity:0;animation:heroEnter 0.7s cubic-bezier(0.22,1,0.36,1) 0.4s forwards;"></div>

      <!-- Подзаголовок -->
      <p class="max-w-md mx-auto mb-12 text-lg"
         style="color:#8888A0;opacity:0;animation:heroEnter 0.8s cubic-bezier(0.22,1,0.36,1) 0.5s forwards;">
        ЦЕЛОЕ. Архитектура жизни. Цельный ремонт.
      </p>

      <!-- CTA-кнопки -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center"
           style="opacity:0;animation:heroEnter 0.8s cubic-bezier(0.22,1,0.36,1) 0.65s forwards;">
        <a href="/zero-day" class="btn-hero">Начать погружение</a>
        <a href="tel:+79615192400" class="btn-hero-ghost flex items-center justify-center gap-2">
          <svg class="w-4 h-4 shrink-0" style="opacity:0.5;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          +7 (961) 519-24-00
        </a>
      </div>
    </div>

    <!-- Индикатор скролла -->
    <div id="scroll-hint"
         class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 transition-opacity duration-500"
         style="opacity:0;animation:heroEnter 1s ease 1.2s forwards;">
      <span style="color:#4A4A5E;font-size:9px;letter-spacing:0.25em;text-transform:uppercase;">Листайте</span>
      <div style="width:1px;height:36px;background:linear-gradient(to bottom,#2E2A24,transparent);"></div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════
       СТАТИСТИКА — мост между тёмным hero и светлым сайтом
  ═══════════════════════════════════════════════════════ -->
  <section style="background:linear-gradient(to bottom, #0A0A0F 0%, #F5F0E8 40%);">
    <div class="max-w-4xl mx-auto px-6 py-20">

      <!-- Плашка с цифрами -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-1 border border-celoe-border"
           style="background:#FAF7F2;">

        <div class="stat-item reveal delay-0 flex flex-col items-center justify-center text-center px-6 py-10
                    border-r border-b md:border-b-0 border-celoe-border">
          <p class="font-display text-5xl mb-3 stat-number" data-value="87"
             style="color:#C8A882;line-height:1;">0</p>
          <p class="text-[10px] tracking-[0.2em] uppercase leading-relaxed" style="color:#A39E99;">
            Завершённых<br/>объектов
          </p>
        </div>

        <div class="stat-item reveal delay-1 flex flex-col items-center justify-center text-center px-6 py-10
                    border-b md:border-b-0 md:border-r border-celoe-border">
          <p class="font-display text-5xl mb-3 stat-number" data-value="6"
             style="color:#C8A882;line-height:1;">0</p>
          <p class="text-[10px] tracking-[0.2em] uppercase leading-relaxed" style="color:#A39E99;">
            Лет<br/>на рынке
          </p>
        </div>

        <div class="stat-item reveal delay-2 flex flex-col items-center justify-center text-center px-6 py-10
                    border-r border-celoe-border">
          <p class="font-display text-5xl mb-3" style="color:#C8A882;line-height:1;">0</p>
          <p class="text-[10px] tracking-[0.2em] uppercase leading-relaxed" style="color:#A39E99;">
            Просроченных<br/>сдач
          </p>
        </div>

        <div class="stat-item reveal delay-3 flex flex-col items-center justify-center text-center px-6 py-10">
          <p class="font-display text-5xl mb-3" style="color:#C8A882;line-height:1;">=</p>
          <p class="text-[10px] tracking-[0.2em] uppercase leading-relaxed" style="color:#A39E99;">
            Смета<br/>не меняется
          </p>
        </div>

      </div>

      <!-- Подпись под статистикой -->
      <p class="text-center mt-8 text-sm reveal delay-2" style="color:#A39E99;letter-spacing:0.05em;">
        Каждая цифра — это обязательство перед клиентом, а не маркетинг
      </p>
    </div>
  </section>

  <!-- Остальные компоненты — уже на светлом фоне -->
  <Manifesto />
  <Vectors />
  <AiConsultant />
  <Portfolio />
  <Calculator />

  <script>
    // ── Скрываем индикатор скролла ──────────────────────────────
    const hint = document.getElementById('scroll-hint');
    window.addEventListener('scroll', () => {
      if (hint) hint.style.opacity = window.scrollY > 60 ? '0' : '1';
    }, { passive: true });

    // ── Счётчики цифр ───────────────────────────────────────────
    const statObs = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        const el  = entry.target;
        const end = parseInt(el.dataset.value);
        if (!end) return;
        let cur = 0;
        const step     = Math.max(1, Math.ceil(end / 45));
        const interval = setInterval(() => {
          cur = Math.min(cur + step, end);
          el.textContent = cur;
          if (cur >= end) clearInterval(interval);
        }, 35);
        statObs.unobserve(el);
      });
    }, { threshold: 0.5 });

    document.querySelectorAll('.stat-number').forEach(el => statObs.observe(el));
  </script>

</MainLayout>