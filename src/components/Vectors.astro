---
---

<section class="py-32 px-6" style="background:#F5F0E8;">
  <div class="max-w-6xl mx-auto">

    <!-- Заголовок -->
    <div class="text-center mb-16 reveal">
      <p class="label mb-4">Найдите свой стиль</p>
      <h2 class="heading-lg" style="color:#1A1714;">Три вектора вашего пространства</h2>
      <div class="divider mx-auto mt-5"></div>
      <p class="text-sm mt-4" style="color:#A39E99;letter-spacing:0.05em;">
        Каждый вектор — это философия жизни, воплощённая в материалах и свете
      </p>
    </div>

    <!-- Карточки -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <!-- I — Эхо классики -->
      <a href="/portfolio" class="vector-card vector-animate group relative overflow-hidden block no-underline"
         style="height:360px;background:#12121A;" data-delay="0">

        <!-- Фото -->
        <div class="parallax-layer absolute inset-0"
             style="will-change:transform;transition:transform 0.15s ease-out;">
          <img src="/images/vector-classic.jpg"
               alt="Эхо классики"
               class="absolute inset-0 w-full h-full object-cover"
               style="opacity:0.7;transform:scale(1.1);transition:opacity 0.5s ease, transform 0.6s cubic-bezier(0.22,1,0.36,1);"
               onerror="this.style.display='none'" />
        </div>

        <!-- Градиент -->
        <div class="absolute inset-0 z-10 transition-opacity duration-500"
             style="background:linear-gradient(to top, rgba(10,10,15,0.92) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"
             data-gradient></div>

        <!-- Контент -->
        <div class="absolute bottom-0 left-0 right-0 p-7 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-2 transition-colors duration-300"
             style="color:#4A4A5E;">Вектор I</p>
          <h3 class="font-display text-2xl text-white mb-2">Эхо классики</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:10px;"></div>
          <p class="text-sm leading-relaxed" style="color:#8888A0;opacity:0;max-height:0;overflow:hidden;transition:opacity 0.4s ease, max-height 0.4s ease;" data-desc>
            Элегантность вне времени. Баланс пропорций и света.
          </p>
        </div>
      </a>

      <!-- II — Честная фактура -->
      <a href="/portfolio" class="vector-card vector-animate group relative overflow-hidden block no-underline"
         style="height:360px;background:#0F0F14;" data-delay="180">

        <div class="parallax-layer absolute inset-0"
             style="will-change:transform;transition:transform 0.15s ease-out;">
          <img src="/images/vector-loft.jpg"
               alt="Честная фактура"
               class="absolute inset-0 w-full h-full object-cover"
               style="opacity:0.7;transform:scale(1.1);transition:opacity 0.5s ease, transform 0.6s cubic-bezier(0.22,1,0.36,1);"
               onerror="this.style.display='none'" />
        </div>

        <div class="absolute inset-0 z-10 transition-opacity duration-500"
             style="background:linear-gradient(to top, rgba(10,10,15,0.92) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"
             data-gradient></div>

        <div class="absolute bottom-0 left-0 right-0 p-7 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-2" style="color:#4A4A5E;">Вектор II</p>
          <h3 class="font-display text-2xl text-white mb-2">Честная фактура</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:10px;"></div>
          <p class="text-sm leading-relaxed" style="color:#8888A0;opacity:0;max-height:0;overflow:hidden;transition:opacity 0.4s ease, max-height 0.4s ease;" data-desc>
            Брутальная эстетика. Открытые текстуры и сталь.
          </p>
        </div>
      </a>

      <!-- III — Тишина и воздух -->
      <a href="/portfolio" class="vector-card vector-animate group relative overflow-hidden block no-underline"
         style="height:360px;background:#111118;" data-delay="360">

        <div class="parallax-layer absolute inset-0"
             style="will-change:transform;transition:transform 0.15s ease-out;">
          <img src="/images/vector-zen.jpg"
               alt="Тишина и воздух"
               class="absolute inset-0 w-full h-full object-cover"
               style="opacity:0.7;transform:scale(1.1);transition:opacity 0.5s ease, transform 0.6s cubic-bezier(0.22,1,0.36,1);"
               onerror="this.style.display='none'" />
        </div>

        <div class="absolute inset-0 z-10 transition-opacity duration-500"
             style="background:linear-gradient(to top, rgba(10,10,15,0.92) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"
             data-gradient></div>

        <div class="absolute bottom-0 left-0 right-0 p-7 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-2" style="color:#4A4A5E;">Вектор III</p>
          <h3 class="font-display text-2xl text-white mb-2">Тишина и воздух</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:10px;"></div>
          <p class="text-sm leading-relaxed" style="color:#8888A0;opacity:0;max-height:0;overflow:hidden;transition:opacity 0.4s ease, max-height 0.4s ease;" data-desc>
            Максимум света. Натуральные материалы и покой.
          </p>
        </div>
      </a>

    </div>

    <p class="text-center mt-10 text-xs reveal delay-3" style="color:#B8B2A8;letter-spacing:0.1em;">
      Не знаете какой стиль ближе? — Спросите нашего AI-консультанта ниже
    </p>

  </div>
</section>

<script>
  // ── Появление карточек ───────────────────────────────────────
  const cards = document.querySelectorAll('.vector-animate');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const delay = parseInt(entry.target.dataset.delay) || 0;
      const card  = entry.target;

      setTimeout(() => {
        card.style.setProperty('opacity',   '1',            'important');
        card.style.setProperty('transform', 'translateY(0)', 'important');
        observer.unobserve(card);
      }, delay);
    });
  }, { threshold: 0.15 });

  cards.forEach(card => {
    card.style.opacity   = '0';
    card.style.transform = 'translateY(50px)';
    card.style.transition = 'opacity 0.9s cubic-bezier(0.22,1,0.36,1), transform 0.9s cubic-bezier(0.22,1,0.36,1)';
    observer.observe(card);
  });

  // ── Hover эффекты ────────────────────────────────────────────
  // Только десктоп
  if (window.matchMedia('(hover: hover)').matches) {
    cards.forEach(card => {
      const img      = card.querySelector('img');
      const gradient = card.querySelector('[data-gradient]');
      const desc     = card.querySelector('[data-desc]');
      const layer    = card.querySelector('.parallax-layer');

      // Hover: фото чёткое, описание появляется
      card.addEventListener('mouseenter', () => {
        if (img) {
          img.style.opacity   = '1';
          img.style.transform = 'scale(1.05)';
        }
        if (gradient) gradient.style.opacity = '0.6';
        if (desc) {
          desc.style.opacity   = '1';
          desc.style.maxHeight = '60px';
        }
      });

      card.addEventListener('mouseleave', () => {
        if (img) {
          img.style.opacity   = '0.7';
          img.style.transform = 'scale(1.1)';
        }
        if (gradient) gradient.style.opacity = '1';
        if (desc) {
          desc.style.opacity   = '0';
          desc.style.maxHeight = '0';
        }
        if (layer) {
          layer.style.transition = 'transform 0.6s cubic-bezier(0.22,1,0.36,1)';
          layer.style.transform  = 'translate(0,0)';
          setTimeout(() => {
            layer.style.transition = 'transform 0.15s ease-out';
          }, 600);
        }
      });

      // Параллакс
      card.addEventListener('mousemove', (e) => {
        if (!layer) return;
        const rect = card.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width  - 0.5) * 2;
        const y = ((e.clientY - rect.top)  / rect.height - 0.5) * 2;
        layer.style.transform = `translate(${x * 10}px, ${y * 10}px)`;
      });

      card.addEventListener('mouseenter', () => {
        if (layer) layer.style.transition = 'transform 0.15s ease-out';
      });
    });
  }
</script>