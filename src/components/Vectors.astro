---
---

<section class="py-32 px-6" style="background:#F5F0E8;">
  <div class="max-w-6xl mx-auto">

    <!-- Заголовок секции -->
    <div class="text-center mb-16 reveal">
      <p class="label mb-4">Найдите свой стиль</p>
      <h2 class="heading-lg" style="color:#1A1714;">Три вектора вашего пространства</h2>
      <div class="divider mx-auto mt-5"></div>
      <p class="text-sm mt-4" style="color:#A39E99;letter-spacing:0.05em;">
        Каждый вектор — это философия жизни, воплощённая в материалах и свете
      </p>
    </div>

    <!-- Карточки -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

      <!-- I — Эхо классики -->
      <div class="vector-card vector-animate group relative overflow-hidden cursor-pointer"
           style="height:420px;background:#12121A;" data-delay="0">

        <!-- Фото (положи: public/images/vector-classic.jpg) -->
        <img src="/images/vector-classic.jpg"
             alt="Эхо классики — классический интерьер"
             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
             style="opacity:0.6;"
             onerror="this.style.display='none'" />

        <!-- Градиент снизу -->
        <div class="absolute inset-0 z-10"
             style="background:linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"></div>

        <!-- Римская цифра — фоновый элемент -->
        <div class="absolute inset-0 flex items-center justify-center z-0">
          <span class="roman-numeral font-display"
                style="font-size:9rem;color:#2A2620;opacity:0.25;line-height:1;user-select:none;">I</span>
        </div>

        <!-- Контент -->
        <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-3" style="color:#4A4A5E;">Вектор I</p>
          <h3 class="font-display text-2xl text-white mb-3">Эхо классики</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:12px;"></div>
          <p class="text-sm leading-relaxed transition-all duration-500 max-h-0 overflow-hidden group-hover:max-h-20"
             style="color:#8888A0;">
            Элегантность вне времени. Баланс пропорций и света.
          </p>
        </div>
      </div>

      <!-- II — Честная фактура -->
      <div class="vector-card vector-animate group relative overflow-hidden cursor-pointer"
           style="height:420px;background:#0F0F14;" data-delay="180">

        <img src="/images/vector-loft.jpg"
             alt="Честная фактура — лофт интерьер"
             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
             style="opacity:0.6;"
             onerror="this.style.display='none'" />

        <div class="absolute inset-0 z-10"
             style="background:linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"></div>

        <div class="absolute inset-0 flex items-center justify-center z-0">
          <span class="roman-numeral font-display"
                style="font-size:9rem;color:#2A2620;opacity:0.25;line-height:1;user-select:none;">II</span>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-3" style="color:#4A4A5E;">Вектор II</p>
          <h3 class="font-display text-2xl text-white mb-3">Честная фактура</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:12px;"></div>
          <p class="text-sm leading-relaxed transition-all duration-500 max-h-0 overflow-hidden group-hover:max-h-20"
             style="color:#8888A0;">
            Брутальная эстетика. Открытые текстуры и сталь.
          </p>
        </div>
      </div>

      <!-- III — Тишина и воздух -->
      <div class="vector-card vector-animate group relative overflow-hidden cursor-pointer"
           style="height:420px;background:#111118;" data-delay="360">

        <img src="/images/vector-zen.jpg"
             alt="Тишина и воздух — минималистичный интерьер"
             class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
             style="opacity:0.6;"
             onerror="this.style.display='none'" />

        <div class="absolute inset-0 z-10"
             style="background:linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.3) 50%, transparent 100%);"></div>

        <div class="absolute inset-0 flex items-center justify-center z-0">
          <span class="roman-numeral font-display"
                style="font-size:9rem;color:#2A2620;opacity:0.25;line-height:1;user-select:none;">III</span>
        </div>

        <div class="absolute bottom-0 left-0 right-0 p-8 z-20">
          <p class="text-[10px] tracking-[0.25em] uppercase mb-3" style="color:#4A4A5E;">Вектор III</p>
          <h3 class="font-display text-2xl text-white mb-3">Тишина и воздух</h3>
          <div style="width:24px;height:1px;background:#C8A882;margin-bottom:12px;"></div>
          <p class="text-sm leading-relaxed transition-all duration-500 max-h-0 overflow-hidden group-hover:max-h-20"
             style="color:#8888A0;">
            Максимум света. Натуральные материалы и покой.
          </p>
        </div>
      </div>

    </div>

    <!-- Подпись под карточками -->
    <p class="text-center mt-10 text-xs reveal delay-3" style="color:#B8B2A8;letter-spacing:0.1em;">
      Не знаете какой стиль ближе? — Спросите нашего AI-консультанта ниже
    </p>

  </div>
</section>

<script>
  const cards = document.querySelectorAll('.vector-animate');

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;

      const delay  = parseInt(entry.target.dataset.delay) || 0;
      const card   = entry.target;
      const numeral = card.querySelector('.roman-numeral');

      setTimeout(() => {
        // Появление карточки
        card.style.setProperty('opacity',   '1',           'important');
        card.style.setProperty('transform', 'translateY(0)', 'important');

        // Анимация римской цифры
        if (numeral) {
          numeral.style.transition = 'all 1.4s cubic-bezier(0.16, 1, 0.3, 1)';
          numeral.style.setProperty('color',       '#C8A882', 'important');
          numeral.style.setProperty('opacity',     '1',       'important');
          numeral.style.setProperty('text-shadow',
            '0 0 60px #C8A882, 0 0 120px #C8A882, 0 0 200px #C8A882', 'important');

          // Пульсация после появления
          setTimeout(() => {
            numeral.animate([
              { textShadow: '0 0 60px #C8A882, 0 0 120px #C8A882, 0 0 200px #C8A882', opacity: 1   },
              { textShadow: '0 0 20px #C8A882, 0 0 50px #C8A882,  0 0 80px #C8A882',  opacity: 0.6 },
              { textShadow: '0 0 60px #C8A882, 0 0 120px #C8A882, 0 0 200px #C8A882', opacity: 1   },
            ], { duration: 3200, iterations: Infinity, easing: 'ease-in-out' });
          }, 1400);
        }

        observer.unobserve(card);
      }, delay);
    });
  }, { threshold: 0.15 });

  cards.forEach(card => {
    card.style.opacity   = '0';
    card.style.transform = 'translateY(60px)';
    card.style.transition = 'opacity 1s cubic-bezier(0.16, 1, 0.3, 1), transform 1s cubic-bezier(0.16, 1, 0.3, 1)';
    observer.observe(card);
  });
</script>