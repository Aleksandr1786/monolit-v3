---
---

<section class="py-32 px-6" style="background:#EDE8DF;">
  <div class="max-w-2xl mx-auto">

    <!-- Заголовок -->
    <div class="text-center mb-12 reveal">
      <p class="label mb-4">Прозрачное ценообразование</p>
      <h2 class="heading-lg" style="color:#1A1714;">Спрогнозируйте стоимость</h2>
      <div class="divider mx-auto mt-5"></div>
      <p class="text-sm mt-4" style="color:#A39E99;">
        Итоговая смета фиксируется на встрече — цена не изменится
      </p>
    </div>

    <!-- Калькулятор -->
    <div class="reveal delay-1 border border-celoe-border p-6 md:p-10" style="background:#FAF7F2;">

      <!-- Тип квартиры — 2x2 на мобильном, 4 в ряд на десктопе -->
      <div class="mb-8">
        <label class="block text-xs tracking-[0.2em] uppercase mb-4" style="color:#A39E99;">
          Тип квартиры
        </label>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-2">
          <button class="type-btn py-3 px-2 border text-xs uppercase tracking-wide transition-all duration-300 active"
                  data-type="studio"
                  style="border-color:#C8A882;color:#1A1714;background:#F5F0E8;">
            Студия
          </button>
          <button class="type-btn py-3 px-2 border text-xs uppercase tracking-wide transition-all duration-300"
                  data-type="1room"
                  style="border-color:#DDD8D0;color:#6B6560;background:transparent;">
            1-комн.
          </button>
          <button class="type-btn py-3 px-2 border text-xs uppercase tracking-wide transition-all duration-300"
                  data-type="2room"
                  style="border-color:#DDD8D0;color:#6B6560;background:transparent;">
            2-комн.
          </button>
          <button class="type-btn py-3 px-2 border text-xs uppercase tracking-wide transition-all duration-300"
                  data-type="3room"
                  style="border-color:#DDD8D0;color:#6B6560;background:transparent;">
            3-комн.
          </button>
        </div>
      </div>

      <!-- Площадь -->
      <div class="mb-8">
        <label class="block text-xs tracking-[0.2em] uppercase mb-4" style="color:#A39E99;">
          Площадь: <span id="area-value" style="color:#1A1714;font-weight:500;">40</span> м²
        </label>
        <input id="area-slider" type="range" min="25" max="120" value="40"
               class="w-full" style="accent-color:#C8A882;" />
        <div class="flex justify-between mt-2">
          <span class="text-xs" style="color:#A39E99;">25 м²</span>
          <span class="text-xs" style="color:#A39E99;">120 м²</span>
        </div>
      </div>

      <!-- Пакеты с расшифровкой -->
      <div class="mb-8">
        <label class="block text-xs tracking-[0.2em] uppercase mb-4" style="color:#A39E99;">
          Пакет работ
        </label>
        <div class="flex flex-col gap-2">

          <button class="pack-btn text-left border transition-all duration-300 p-4"
                  data-pack="base"
                  style="border-color:#DDD8D0;background:transparent;">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-medium uppercase tracking-wide" style="color:#6B6560;">Основа</span>
              <span class="text-xs" style="color:#A39E99;">от 6 000 ₽/м²</span>
            </div>
            <p class="text-xs leading-relaxed" style="color:#A39E99;">
              Чистовая отделка стен, потолков и полов. Электрика и сантехника по готовым трассам. Без дизайн-проекта.
            </p>
          </button>

          <button class="pack-btn text-left border transition-all duration-300 p-4 active"
                  data-pack="full"
                  style="border-color:#C8A882;background:#F5F0E8;">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-medium uppercase tracking-wide" style="color:#1A1714;">Целое</span>
              <span class="text-xs" style="color:#C8A882;">от 9 500 ₽/м²</span>
            </div>
            <p class="text-xs leading-relaxed" style="color:#6B6560;">
              Всё что в «Основе» + Нулевой День, 3D-визуализация, фиксированная смета, ежедневные отчёты, клининг после сдачи.
            </p>
          </button>

          <button class="pack-btn text-left border transition-all duration-300 p-4"
                  data-pack="arch"
                  style="border-color:#DDD8D0;background:transparent;">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-medium uppercase tracking-wide" style="color:#6B6560;">Архитектура</span>
              <span class="text-xs" style="color:#A39E99;">от 16 000 ₽/м²</span>
            </div>
            <p class="text-xs leading-relaxed" style="color:#A39E99;">
              Всё что в «Целое» + авторский дизайн-проект, подбор и закупка материалов, видеонаблюдение, цифровой паспорт квартиры.
            </p>
          </button>

        </div>
      </div>

      <!-- Результат -->
      <div class="border-t border-celoe-border pt-6 mb-6">
        <div class="flex items-end justify-between gap-4">
          <div>
            <p class="text-xs tracking-[0.2em] uppercase mb-2" style="color:#A39E99;">
              Ориентировочная стоимость
            </p>
            <p class="font-display text-4xl" id="price" style="color:#1A1714;line-height:1;">
              380 000 ₽
            </p>
          </div>
          <p class="text-xs text-right" style="color:#A39E99;line-height:1.6;max-width:120px;">
            Точная цена<br/>фиксируется<br/>на встрече
          </p>
        </div>
      </div>

      <a href="/zero-day" class="btn-primary w-full no-underline text-center">
        Запланировать Нулевой День
      </a>

    </div>

    <p class="text-center text-xs mt-6 reveal delay-2" style="color:#B8B2A8;letter-spacing:0.05em;">
      Нулевой День — бесплатный выезд, замер и фиксация сметы
    </p>

  </div>
</section>

<script>
  const slider    = document.getElementById('area-slider');
  const areaValue = document.getElementById('area-value');
  const priceEl   = document.getElementById('price');
  const typeBtns  = document.querySelectorAll('.type-btn');
  const packBtns  = document.querySelectorAll('.pack-btn');

  const typePrices = { studio: 0, '1room': 500, '2room': 1000, '3room': 1500 };
  const packPrices = { base: 6000, full: 9500, arch: 16000 };

  let currentType = 'studio';
  let currentPack = 'full';

  function updatePrice() {
    const area  = parseInt(slider.value);
    const price = area * (packPrices[currentPack] + typePrices[currentType]);
    areaValue.textContent = area;
    priceEl.textContent   = price.toLocaleString('ru-RU') + ' ₽';
  }

  function activateTypeBtn(clicked) {
    typeBtns.forEach(b => {
      b.style.borderColor = '#DDD8D0';
      b.style.color       = '#6B6560';
      b.style.background  = 'transparent';
    });
    clicked.style.borderColor = '#C8A882';
    clicked.style.color       = '#1A1714';
    clicked.style.background  = '#F5F0E8';
  }

  function activatePackBtn(clicked) {
    packBtns.forEach(b => {
      b.style.borderColor = '#DDD8D0';
      b.style.background  = 'transparent';
      // Текст названия пакета
      const title = b.querySelector('span:first-child');
      const price = b.querySelector('span:last-child');
      const desc  = b.querySelector('p');
      if (title) title.style.color = '#6B6560';
      if (price) price.style.color = '#A39E99';
      if (desc)  desc.style.color  = '#A39E99';
    });
    clicked.style.borderColor = '#C8A882';
    clicked.style.background  = '#F5F0E8';
    const title = clicked.querySelector('span:first-child');
    const price = clicked.querySelector('span:last-child');
    const desc  = clicked.querySelector('p');
    if (title) title.style.color = '#1A1714';
    if (price) price.style.color = '#C8A882';
    if (desc)  desc.style.color  = '#6B6560';
  }

  slider.addEventListener('input', updatePrice);

  typeBtns.forEach(btn => btn.addEventListener('click', () => {
    activateTypeBtn(btn);
    currentType = btn.dataset.type;
    updatePrice();
  }));

  packBtns.forEach(btn => btn.addEventListener('click', () => {
    activatePackBtn(btn);
    currentPack = btn.dataset.pack;
    updatePrice();
  }));

  updatePrice();
</script>